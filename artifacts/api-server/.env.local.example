# Ambiente local do backend (desenvolvimento)
# Copie este arquivo para .env.local e ajuste os valores.

NODE_ENV=development
PORT=3001

# Chave de sessao JWT
SESSION_SECRET=troque-por-uma-chave-forte-local

# Chave para criptografia de dados sensiveis
DATA_ENCRYPTION_KEY=troque-por-uma-chave-forte-local

# CORS para frontend local
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Em dev, deixe false para nao rodar migracao em todo boot
RUN_DATA_SECURITY_MIGRATION=false

# Escolha UMA opcao de credencial Firebase:

# Opcao 1: caminho para o arquivo JSON da service account
FIREBASE_SERVICE_ACCOUNT_PATH=C:/caminho/para/firebase-service-account.json

# Opcao 2: JSON inline (menos recomendado no arquivo)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
